SUPABASE_URL=https://your-project-ref.supabase.co
# Secret / service-role key. Never put this in an EXPO_PUBLIC_* variable.
SUPABASE_SECRET_KEY=your-secret-key-here
# Bearer token callers send. At least 32 characters: openssl rand -base64 32
API_KEY=your-api-key-here
# IANA timezone that metric periods are computed in
USER_TZ=Europe/London
